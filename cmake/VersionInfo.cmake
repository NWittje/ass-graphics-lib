include_guard(GLOBAL)
# All non-imported graphics helpers/examples/tests own this graphics release.
function(ass_stamp_directory directory version)
  string(REPLACE "." "," ASS_VERSION_NUMERIC "${version}.0")
  set(ASS_VERSION_STRING "${version}.0")
  get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(target IN LISTS targets)
    get_target_property(type "${target}" TYPE)
    get_target_property(imported "${target}" IMPORTED)
    get_target_property(stamped "${target}" ASS_VERSION_STAMPED)
    if(imported OR stamped OR NOT type MATCHES "^(EXECUTABLE|SHARED_LIBRARY|MODULE_LIBRARY)$")
      continue()
    endif()
    set(ASS_VERSION_FILETYPE VFT_DLL)
    if(type STREQUAL "EXECUTABLE")
      set(ASS_VERSION_FILETYPE VFT_APP)
    endif()
    set(ASS_VERSION_DESCRIPTION "${target}")
    get_target_property(binary_directory "${target}" BINARY_DIR)
    set(resource "${binary_directory}/windows-version/${target}.rc")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/application.rc.in" "${resource}" @ONLY)
    target_sources("${target}" PRIVATE "${resource}")
    set_property(TARGET "${target}" PROPERTY ASS_VERSION_STAMPED TRUE)
  endforeach()
endfunction()
