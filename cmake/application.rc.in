#include <winver.h>
1 VERSIONINFO
 FILEVERSION @ASS_VERSION_NUMERIC@
 PRODUCTVERSION @ASS_VERSION_NUMERIC@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @ASS_VERSION_FILETYPE@
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "@ASS_VERSION_DESCRIPTION@\0"
   VALUE "FileVersion", "@ASS_VERSION_STRING@\0"
   VALUE "InternalName", "@ASS_VERSION_DESCRIPTION@\0"
   VALUE "ProductName", "ASS Graphics Lib\0"
   VALUE "ProductVersion", "@ASS_VERSION_STRING@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
