<Project>
  <PropertyGroup>
    <Version>1.6.0</Version>
    <AssemblyVersion>1.6.0.0</AssemblyVersion>
    <FileVersion>1.6.0.0</FileVersion>
    <Product>ASS Graphics Lib</Product>
    <!-- Old P outputs remain historical. An external artifacts root must not
         make their generated AssemblyInfo files part of the maintained source. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
