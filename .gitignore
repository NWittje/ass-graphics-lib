# Source-only repository: local delivery, tests, tools and work stay untracked.
/*
!/.gitignore
!/.gitattributes
!/.clang-format
!/.editorconfig
!/README.md
!/CMakeLists.txt
!/CMakePresets.json
!/Directory.Build.props
!/cmake/
!/include/
!/src/
!/managed/
!/resources/
!/licenses/
!/examples/

# Generated outputs are excluded even inside source directories.
**/bin/
**/obj/
**/.vs/
**/__pycache__/
**/CMakeFiles/
**/CMakeCache.txt
*.user
*.suo
*.dll
*.exe
*.pdb
*.lib
*.obj
*.pch
*.ipch
*.ilk
*.exp
*.cso
*.pyc
*.binlog
*.log
*.zip
*.7z